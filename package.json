{
  "name": "relax-eyes-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A local Spine desktop pet with a 20-minute eye-relaxation reminder.",
  "scripts": {
    "pet-packs:generate": "node scripts/generate-pet-packs.cjs",
    "pet-packs:validate": "node scripts/validate-pet-packs.cjs",
    "pet-packs:previews": "node scripts/generate-pet-previews.cjs",
    "pet-packs:update": "node scripts/update-pet-pack.cjs",
    "pet-packs:import-codex": "node scripts/import-codex-role-packs.cjs",
    "tauri:prepare": "node scripts/prepare-tauri.cjs",
    "tauri:dev": "node scripts/run-tauri.cjs dev",
    "tauri:build": "node scripts/run-tauri.cjs build --no-bundle",
    "tauri:portable": "node scripts/run-tauri.cjs build --no-bundle && node scripts/package-tauri.cjs",
    "codex:send": "node scripts/send-codex-event.cjs",
    "test:codex-hook": "node scripts/test-codex-pet-hook.cjs"
  },
  "devDependencies": {}
}
