{
  "$schema": "../manifest.schema.json",
  "schemaVersion": 1,
  "id": "yao",
  "name": "瑶",
  "engine": "spine",
  "version": "1.0.0",
  "assets": {
    "sourceRoot": "assets/yao",
    "skeleton": "/assets/yao/yao.skel",
    "atlas": "/assets/yao/yao.atlas",
    "textures": [
      "/assets/yao/yao.png"
    ]
  },
  "standard": {
    "referenceModel": "tutu",
    "width": 360,
    "height": 360,
    "fitScale": 0.68,
    "anchor": {
      "x": 0.5,
      "y": 1
    },
    "baseline": 0.92,
    "safeMargin": {
      "left": 0.02,
      "top": 0.02,
      "right": 0.02,
      "bottom": 0.02
    }
  },
  "hit": {
    "mode": "visible-bounds",
    "padding": 0.02
  },
  "actions": {
    "initial": "Relax",
    "raw": [],
    "aliases": {
      "Relax": "Relax",
      "Idle": "Idle",
      "Interact": "Interact",
      "Move": "Move",
      "Sit": "Sit",
      "Sleep": "Sleep",
      "Special": "Special",
      "Start": "Relax"
    },
    "cooldownMs": 1800,
    "interruptible": true
  },
  "capabilities": {
    "idle": true,
    "click": true,
    "hover": true,
    "drag": true,
    "run": true,
    "sleep": true,
    "reminder": true
  },
  "preview": {
    "static": "/assets/yao/yao.png",
    "actions": {}
  },
  "calibration": {
    "offsetX": 0,
    "offsetY": 0,
    "scaleX": 1,
    "scaleY": 1,
    "hitPadding": 0
  }
}
