{
  "$schema": "../manifest.schema.json",
  "schemaVersion": 1,
  "id": "tutu",
  "name": "图图",
  "engine": "spine",
  "version": "1.0.0",
  "assets": {
    "sourceRoot": "assets/tutu",
    "skeleton": "/assets/tutu/tutu.skel",
    "atlas": "/assets/tutu/tutu.atlas",
    "textures": [
      "/assets/tutu/tutu.png"
    ]
  },
  "standard": {
    "referenceModel": "tutu",
    "width": 360,
    "height": 360,
    "fitScale": 0.68,
    "anchor": {
      "x": 0.5,
      "y": 1
    },
    "baseline": 0.92,
    "safeMargin": {
      "left": 0.02,
      "top": 0.02,
      "right": 0.02,
      "bottom": 0.02
    }
  },
  "hit": {
    "mode": "focus-prefix",
    "focusPrefix": "F_",
    "padding": 0.02
  },
  "actions": {
    "initial": "Relax",
    "raw": [
      "Relax",
      "Sit",
      "Sleep",
      "Move",
      "Interact"
    ],
    "aliases": {
      "Relax": "Relax",
      "Idle": "Relax",
      "Interact": "Interact",
      "Move": "Move",
      "Sit": "Sit",
      "Sleep": "Sleep",
      "Special": "Interact",
      "Start": "Relax"
    },
    "cooldownMs": 1800,
    "interruptible": true
  },
  "capabilities": {
    "idle": true,
    "click": true,
    "hover": true,
    "drag": true,
    "run": true,
    "sleep": true,
    "reminder": true
  }
}
