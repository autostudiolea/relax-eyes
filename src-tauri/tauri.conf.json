{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relax Eyes Desktop",
  "version": "0.1.0",
  "identifier": "local.relaxeyes.desktop",
  "build": {
    "frontendDist": "../web-dist",
    "beforeDevCommand": "npm run tauri:prepare",
    "beforeBuildCommand": "npm run tauri:prepare"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
